# SysMonitor — Node Agent Environment Variables
# Copy to .env or set in systemd service file
#
# Works unmodified on Ubuntu/Debian PCs & servers and on Raspberry Pi boards —
# hardware (and any local LLM ports serving a model) is auto-detected at
# startup, no platform-specific config needed.

# Bind address (0.0.0.0 listens on all interfaces)
SYSMONITOR_HOST=0.0.0.0

# Listen port
SYSMONITOR_PORT=8585

# Bearer token for API authentication (leave empty to disable auth)
SYSMONITOR_TOKEN=

# Comma-separated list of systemd services to monitor
SYSMONITOR_SERVICES=ssh,nginx,docker,ollama,mosquitto

# Dashboard auto-refresh interval in seconds
SYSMONITOR_REFRESH=2

# Path to persist the service list across restarts
SYSMONITOR_SERVICES_FILE=./services.json

# Flask debug mode (never enable in production)
SYSMONITOR_DEBUG=false

# ── Security monitoring (hiddenscope integration) ───────────────────────────
# Minimum severity that counts as "actionable" (drives the dashboard's red
# Security Alert card and the fleet-wide alert count on the Hub). Live
# connection scoring only ever produces "high" or "info" — static scans can
# also produce "critical"/"medium". One of: info, low, medium, high, critical.
HIDDENSCOPE_MIN_SEVERITY=high

# Server-side-only directory for the on-demand static secret/reverse-shell
# scan (POST /api/security/scan). Left empty, the scan endpoint is disabled.
# Deliberately NOT settable via the API/UI — accepting a path from a web
# request would let a client trigger an arbitrary-filesystem scan.
HIDDENSCOPE_SCAN_PATH=

# Where the security allowlist (ignored ports/procs/networks) is persisted.
HIDDENSCOPE_ALLOWLIST_FILE=./hiddenscope_allowlist.json


# SysMonitor Hub — additional variables (hub only)

SYSHUB_HOST=0.0.0.0
SYSHUB_PORT=8686
SYSHUB_TOKEN=
SYSHUB_POLL_INTERVAL=5
SYSHUB_TIMEOUT=4
SYSHUB_DISCOVERY_PORT=8585
SYSHUB_NODES_FILE=./hub_nodes.json
SYSHUB_DEBUG=false

# Outbound alert webhook — POSTed on node online/offline, temperature,
# power, and security-finding transitions (fires once per transition, not
# every poll cycle). Leave empty to disable.
SYSHUB_ALERT_WEBHOOK_URL=
